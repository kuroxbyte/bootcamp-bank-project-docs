an" style="endArrow=open;dashed=1;html=1;rounded=0;fontSize=10;strokeColor=#d79b00;fontColor=#b46504;labelBackgroundColor=#ffffff;exitX=0.1;exitY=1;entryX=0.8;entryY=0;" edge="1" parent="1" source="group" target="discovery"><mxGeometry x="0" y="0" relative="1" as="geometry"><Array as="points"></Array><mxPoint as="offset" x="0" y="0"/></mxGeometry></mxCell><mxCell id="reg_gw" value="registro y&lt;br&gt;resolución lb://" style="endArrow=open;dashed=1;html=1;rounded=0;fontSize=10;strokeColor=#d79b00;fontColor=#b46504;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="gateway" target="discovery"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="reg_cfg" value="" style="endArrow=open;dashed=1;html=1;rounded=0;fontSize=10;strokeColor=#d79b00;fontColor=#b46504;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="config" target="discovery"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;── REST síncrono (WebClient); destinos&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;resueltos por Eureka (lb://)&lt;br&gt;&lt;font color='#3a7d2c'&gt;── Persistencia: Spring Data Reactive MongoDB&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(consultas derivadas, sin @Query)&lt;/font&gt;&lt;br&gt;&lt;font color='#9673a6'&gt;- - Configuración externalizada&lt;/font&gt;&lt;br&gt;&lt;font color='#b46504'&gt;- - Registro en Eureka&lt;/font&gt;&lt;br&gt;&lt;br&gt;Llamadas entre servicios y rutas del gateway:&lt;br&gt;circuit breaker Resilience4j, timeout 2 s&lt;br&gt;&lt;br&gt;Errores: Problem Details&lt;br&gt;400 · 404 · 422 · 503" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;strokeColor=#999999;fillColor=#ffffff;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1180" y="110" width="270" height="230" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>